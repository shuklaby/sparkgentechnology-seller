rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the current user has ADMIN role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN') ||
        (request.auth.token.phone_number == '+917897752217' || request.auth.token.phone_number == '7897752217')
      );
    }
    
    // Check if authenticated user is the owner seller
    function isSellerOwner(sellerId) {
      return isAuthenticated() && (
        request.auth.uid == sellerId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerId == sellerId)
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Sellers collection
    match /sellers/{sellerId} {
      // Anyone can read if published / public site viewing, or if owner / admin
      allow read: if resource.data.isPublished == true || isSellerOwner(sellerId) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isSellerOwner(sellerId) || isAdmin();

      // Products subcollection
      match /products/{productId} {
        allow read: if true; // Public catalog viewing
        allow write: if isSellerOwner(sellerId) || isAdmin();
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId) || isAdmin();
      }

      // Website Settings subcollection
      match /websiteSettings/{docId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId) || isAdmin();
      }

      // Social Links subcollection
      match /socialLinks/{docId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId) || isAdmin();
      }

      // SEO subcollection
      match /seo/{docId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId) || isAdmin();
      }

      // Domains subcollection
      match /domains/{docId} {
        allow read: if isSellerOwner(sellerId) || isAdmin();
        allow write: if isSellerOwner(sellerId) || isAdmin();
      }
    }
  }
}
