rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - Managed securely via server auth endpoints & scrypt hashing
    match /users/{userId} {
      allow read, write: if true;
    }

    // Sellers collection - Public storefronts & seller catalogs
    match /sellers/{sellerId} {
      allow read, write: if true;

      // Subcollections (products, categories, websiteSettings, socialLinks, seo, domains)
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
  }
}
