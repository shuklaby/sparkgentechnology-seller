{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "Normalized email address / user ID" },
        "displayName": { "type": "string", "description": "User display title or full name" },
        "role": { "type": "string", "description": "User role: ADMIN, SELLER, or EMPLOYEE" },
        "status": { "type": "string", "description": "Account status: ACTIVE or INACTIVE" },
        "mobileNumber": { "type": "string", "description": "Optional mobile phone number" },
        "sellerId": { "type": "string", "description": "Optional linked seller tenant ID" },
        "passwordHash": { "type": "string", "description": "Secure scrypt password hash" },
        "salt": { "type": "string", "description": "Cryptographic salt" },
        "createdAt": { "type": "number", "description": "Timestamp in milliseconds" },
        "lastLoginAt": { "type": "number", "description": "Timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Timestamp in milliseconds" }
      }
    },
    "Seller": {
      "collection": "sellers",
      "fields": {
        "id": { "type": "string", "description": "Seller Profile ID" },
        "companyName": { "type": "string", "description": "Company legal or trade name" },
        "slug": { "type": "string", "description": "Unique URL identifier for tenant website" },
        "logoUrl": { "type": "string", "description": "Logo URL" },
        "businessDescription": { "type": "string", "description": "Summary of products and operations" },
        "mobileNumber": { "type": "string", "description": "Contact phone" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp contact" },
        "email": { "type": "string", "description": "Inquiry email" },
        "address": { "type": "string", "description": "Factory or office address" },
        "city": { "type": "string", "description": "City" },
        "state": { "type": "string", "description": "State / Province" },
        "country": { "type": "string", "description": "Country" },
        "pincode": { "type": "string", "description": "Postal code" },
        "businessType": { "type": "string", "description": "Manufacturer / Wholesaler / Exporter" },
        "yearEstablished": { "type": "number", "description": "Year founded" },
        "isActive": { "type": "boolean", "description": "Admin operational status" },
        "isPublished": { "type": "boolean", "description": "Public visibility flag" },
        "ownerUid": { "type": "string", "description": "Firebase UID of tenant owner" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Update timestamp" }
      }
    }
  }
}
